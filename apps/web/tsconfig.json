{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@msqdx/ui": [
        "./lib/msqdx-ui.ts"
      ],
      "@msqdx/ui-shell": [
        "./lib/msqdx-ui-shell.ts"
      ],
      "@msqdx/ui-client": [
        "./lib/msqdx-ui-client.ts"
      ],
      "@msqdx/ui/styles.css": [
        "../../../msqdx-ui/packages/ui/src/styles.css"
      ],
      "@msqdx/ui-tokens": [
        "../../../msqdx-ui/packages/ui-tokens/src/index.ts"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
