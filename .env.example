# Required for live PLEXON federation. No default is accepted in production.
PLEXON_FEDERATION_MODE=dummy
PLEXON_SERVICE_SECRET=
NEXT_PLEXON_BASE_URL=http://localhost:3334
PLEXON_AUTH_URL=
AUTH_SECRET=

# Postgres is required for live provisioning. Run reviewed migrations separately.
DATABASE_URL=

# S3-compatible private object storage. All five values are required together.
VIDEON_OBJECT_STORAGE_REGION=
VIDEON_OBJECT_STORAGE_BUCKET=
VIDEON_OBJECT_STORAGE_ENDPOINT=
VIDEON_OBJECT_STORAGE_ACCESS_KEY_ID=
VIDEON_OBJECT_STORAGE_SECRET_ACCESS_KEY=
VIDEON_OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Public UI base is configuration, never embedded in route handlers.
NEXT_PUBLIC_VIDEON_URL=http://localhost:3010

# OpenRouter gateway — never expose this key to the browser.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
VIDEON_VISION_DEFAULT_MODEL=qwen/qwen3.7-flash
# Optional override for a separate strict-schema evaluation lane. Unset = retry Qwen3.7 Flash with JSON Schema.
# VIDEON_VISION_SCHEMA_FALLBACK_MODEL=qwen/qwen3-vl-30b-a3b-instruct
VIDEON_VISION_DIRECT_VIDEO_ENABLED=false
VIDEON_OPENROUTER_DATA_COLLECTION=deny
VIDEON_OPENROUTER_REQUIRE_ZDR=false

# Transcription: auto prefers OpenRouter when OPENROUTER_API_KEY is set (quality), else local Whisper.
# Provider: local | openrouter | auto
VIDEON_TRANSCRIPTION_ENABLED=true
VIDEON_TRANSCRIPTION_PROVIDER=auto
VIDEON_TRANSCRIPTION_OPENROUTER_MODEL=openai/gpt-4o-mini-transcribe
VIDEON_WHISPER_MODEL=small
VIDEON_WHISPER_LANGUAGE=de

# Optional: install demucs in the runtime image for neural stems.
# Users always pick Stem method in the Media Editor UI (Schnell vs Neural).
# If demucs is missing, analysis falls back to ffmpeg mid/side automatically.
# VIDEON_STEM_DEMUCS_ENABLED is unused for gating; kept for ops docs only.
# VIDEON_STEM_DEMUCS_ENABLED=false
